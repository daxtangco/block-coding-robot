// Helper functions exposed to generated code

void moveArmToPose(const int pose[5]) {
  setServoAngle(SERVO_BASE, pose[0]);
  setServoAngle(SERVO_SHOULDER, pose[1]);
  setServoAngle(SERVO_ELBOW, pose[2]);
  setServoAngle(SERVO_WRIST, pose[3]);
  setServoAngle(SERVO_GRIPPER, pose[4]);
  delay(500); // Allow servos to reach position
}

void openClaw() {
  setServoAngle(SERVO_GRIPPER, GRIPPER_OPEN);
  delay(300);
}

void closeClaw() {
  setServoAngle(SERVO_GRIPPER, GRIPPER_CLOSE);
  delay(300);
}

bool cameraSees(const String& className, int minConfidence) {
  return (lastDetection == className && lastConfidence >= minConfidence);
}

