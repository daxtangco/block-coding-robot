// Helper function: Convert angle (0-180) to PWM pulse length
int angleToPulse(int angle) {
  // Constrain angle to valid range
  angle = constrain(angle, 0, 180);

  // Map angle to pulse length
  return map(angle, 0, 180, SERVOMIN, SERVOMAX);
}

// Helper function: Set servo position by channel
void setServoAngle(uint8_t channel, int angle) {
  int pulse = angleToPulse(angle);
  pwm.setPWM(channel, 0, pulse);

  // Update current position
  if (channel < 5) {
    currentPos[channel] = angle;
  }
}

void setup() {
  Serial.begin(115200);
  Serial.println("Starting Arm Controller with PCA9685...");

  // Initialize I2C
  Wire.begin(SDA_PIN, SCL_PIN);

  // Initialize PCA9685
  pwm.begin();
  pwm.setPWMFreq(SERVO_FREQ);

  // Wait for PCA9685 to stabilize
  delay(10);

  // Set all servos to initial positions
  setServoAngle(SERVO_BASE, 90);
  setServoAngle(SERVO_SHOULDER, 60);
  setServoAngle(SERVO_ELBOW, 70);
  setServoAngle(SERVO_WRIST, 60);
  setServoAngle(SERVO_GRIPPER, 90);

  Serial.println("PCA9685 initialized");

  // Connect to Blynk
  Serial.print("Connecting to WiFi: ");
  Serial.println(ssid);
  Blynk.begin(BLYNK_AUTH_TOKEN, ssid, pass);

  Serial.println("Arm controller ready");
}

void loop() {
